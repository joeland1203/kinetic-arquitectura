<!-- Script de Three.js con GLTFLoader, OrbitControls y MeshoptDecoder -->
<script>
	import * as THREE from 'three';
	import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
	import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
	import { MeshoptDecoder } from 'meshoptimizer';

	// Referencias del DOM
	const canvas = document.getElementById('modelCanvas') as HTMLCanvasElement;
	const canvasWrapper = document.getElementById('canvasWrapper') as HTMLDivElement;
	const loaderOverlay = document.getElementById('loaderOverlay') as HTMLDivElement;
	const loadingPercentText = document.getElementById('loadingPercentText') as HTMLDivElement;
	const loadingBar = document.getElementById('loadingBar') as HTMLDivElement;
	const loaderStatusText = document.getElementById('loaderStatusText') as HTMLDivElement;
	const errorOverlay = document.getElementById('errorOverlay') as HTMLDivElement;
	const errorMessage = document.getElementById('errorMessage') as HTMLParagraphElement;
	const retryLoadBtn = document.getElementById('retryLoadBtn') as HTMLButtonElement;

	const toggleAutoRotateBtn = document.getElementById('toggleAutoRotateBtn') as HTMLButtonElement;
	const rotateIcon = document.getElementById('rotateIcon') as HTMLSpanElement;
	const rotateLabel = document.getElementById('rotateLabel') as HTMLSpanElement;
	const resetCameraBtn = document.getElementById('resetCameraBtn') as HTMLButtonElement;

	// Modal
	const techModal = document.getElementById('techModal') as HTMLDivElement;
	const openModalBtn = document.getElementById('openModalBtn') as HTMLButtonElement;
	const closeModalBtn = document.getElementById('closeModalBtn') as HTMLButtonElement;
	const closeModalFooterBtn = document.getElementById('closeModalFooterBtn') as HTMLButtonElement;
	const modalContactBtn = document.getElementById('modalContactBtn') as HTMLAnchorElement;

	// Variables de Escena Three.js
	let scene: THREE.Scene;
	let camera: THREE.PerspectiveCamera;
	let renderer: THREE.WebGLRenderer;
	let controls: OrbitControls;
	let modelGroup: THREE.Group | null = null;
	let animationFrameId: number;
	let isAutoRotating = true;

	const initialCameraPos = new THREE.Vector3();
	const initialCameraTarget = new THREE.Vector3(0, 0, 0);

	function updateAutoRotateUI(active: boolean) {
		isAutoRotating = active;
		if (controls) {
			controls.autoRotate = active;
		}
		if (rotateLabel) {
			rotateLabel.textContent = active ? 'Auto-rotación ON' : 'Auto-rotación OFF';
		}
		if (rotateIcon) {
			rotateIcon.style.transform = active ? 'rotate(180deg)' : 'rotate(0deg)';
		}
	}

	function initScene() {
		if (!canvas || !canvasWrapper) return;

		// 1. Crear Escena
		scene = new THREE.Scene();

		// 2. Crear Cámara con campo de visión arquitectónico
		const width = canvasWrapper.clientWidth;
		const height = canvasWrapper.clientHeight;
		camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);

		// 3. Crear Renderer optimizado con tone mapping
		renderer = new THREE.WebGLRenderer({
			canvas,
			antialias: true,
			alpha: true,
			powerPreference: 'high-performance'
		});
		renderer.setSize(width, height);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
		renderer.toneMapping = THREE.ACESFilmicToneMapping;
		renderer.toneMappingExposure = 1.2;
		renderer.outputColorSpace = THREE.SRGBColorSpace;
		renderer.shadowMap.enabled = true;
		renderer.shadowMap.type = THREE.PCFShadowMap;

		// 4. Iluminación de Estudio Arquitectónico
		// - Luz ambiental suave
		const ambientLight = new THREE.AmbientLight(0xffffff, 1.1);
		scene.add(ambientLight);

		// - Hemisphere light para dar calidez al cenit y sombra fría en la base
		const hemiLight = new THREE.HemisphereLight(0xfff6ea, 0x141824, 0.7);
		scene.add(hemiLight);

		// - Directional Light Cálida (Key Light - Sol rasante arquitectónico que define volúmenes)
		const keyLight = new THREE.DirectionalLight(0xffecd2, 2.6);
		keyLight.position.set(4.5, 7.5, 4.5);
		keyLight.castShadow = true;
		keyLight.shadow.mapSize.width = 2048;
		keyLight.shadow.mapSize.height = 2048;
		keyLight.shadow.camera.near = 0.5;
		keyLight.shadow.camera.far = 25;
		keyLight.shadow.camera.left = -2.5;
		keyLight.shadow.camera.right = 2.5;
		keyLight.shadow.camera.top = 2.5;
		keyLight.shadow.camera.bottom = -2.5;
		keyLight.shadow.bias = -0.0003;
		scene.add(keyLight);

		// - Directional Light Fría de Relleno (Fill Light - Equilibra sombras)
		const fillLight = new THREE.DirectionalLight(0x90caf9, 1.3);
		fillLight.position.set(-6, 3, -4);
		scene.add(fillLight);

		// - Directional Light de Contorno (Rim Light - Despega la silueta del fondo oscuro)
		const rimLight = new THREE.DirectionalLight(0xffffff, 1.1);
		rimLight.position.set(0, 4, -6);
		scene.add(rimLight);

		// 5. Configurar OrbitControls con Damping suave
		controls = new OrbitControls(camera, renderer.domElement);
		controls.enableDamping = true;
		controls.dampingFactor = 0.05;
		controls.screenSpacePanning = true;
		controls.zoomSpeed = 0.7;

		// Auto-rotación inicial
		controls.autoRotate = true;
		controls.autoRotateSpeed = 0.85;

		// El auto-rotate se detiene de inmediato cuando el usuario interactúa manualmente
		controls.addEventListener('start', () => {
			updateAutoRotateUI(false);
		});

		// 6. Bucle de animación
		function animate() {
			animationFrameId = requestAnimationFrame(animate);
			controls.update();
			renderer.render(scene, camera);
		}
		animate();

		// 7. Manejo responsive mediante ResizeObserver
		const resizeObserver = new ResizeObserver(() => {
			if (!canvasWrapper || !renderer || !camera) return;
			const newWidth = canvasWrapper.clientWidth;
			const newHeight = canvasWrapper.clientHeight;
			if (newWidth === 0 || newHeight === 0) return;

			camera.aspect = newWidth / newHeight;
			camera.updateProjectionMatrix();
			renderer.setSize(newWidth, newHeight);
			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
		});
		resizeObserver.observe(canvasWrapper);
	}

	async function loadModel() {
		// Mostrar loader
		if (loaderOverlay) {
			loaderOverlay.classList.remove('opacity-0', 'pointer-events-none');
			loaderOverlay.style.display = 'flex';
		}
		if (errorOverlay) {
			errorOverlay.classList.add('hidden');
			errorOverlay.style.display = 'none';
		}
		if (loadingBar) loadingBar.style.width = '10%';
		if (loadingPercentText) loadingPercentText.textContent = '10%';

		try {
			if (loaderStatusText) {
				loaderStatusText.textContent = 'Inicializando MeshoptDecoder...';
			}

			// Asegurar que el decodificador de Meshopt esté listo
			await MeshoptDecoder.ready;

			if (loadingBar) loadingBar.style.width = '30%';
			if (loadingPercentText) loadingPercentText.textContent = '30%';

			if (loaderStatusText) {
				loaderStatusText.textContent = 'Descargando geometría comprimida (12.6 MB)...';
			}

			const loader = new GLTFLoader();
			// Asignar el decodificador para descomprimir EXT_meshopt_compression
			loader.setMeshoptDecoder(MeshoptDecoder);

			loader.load(
				'/models/casa_flotante.glb',
				(gltf) => {
					if (loadingBar) loadingBar.style.width = '85%';
					if (loadingPercentText) loadingPercentText.textContent = '85%';
					if (loaderStatusText) {
						loaderStatusText.textContent = 'Calculando volúmenes y centrando escena...';
					}

					const model = gltf.scene;

					// Calcular BoundingBox y BoundingSphere para centrado automático exacto
					const box = new THREE.Box3().setFromObject(model);
					const center = box.getCenter(new THREE.Vector3());
					const size = box.getSize(new THREE.Vector3());
					const sphere = box.getBoundingSphere(new THREE.Sphere());

					// Centrar geometría en el origen local (0, 0, 0)
					model.position.x = -center.x;
					model.position.y = -center.y;
					model.position.z = -center.z;

					// Configurar sombras y propiedades de material
					model.traverse((child) => {
						if ((child as THREE.Mesh).isMesh) {
							child.castShadow = true;
							child.receiveShadow = true;

							const mesh = child as THREE.Mesh;
							if (mesh.material) {
								const mat = mesh.material as THREE.MeshStandardMaterial;
								mat.roughness = Math.min(mat.roughness ?? 0.5, 0.65);
								mat.needsUpdate = true;
							}
						}
					});

					// Crear grupo contenedor en la escena
					if (modelGroup) {
						scene.remove(modelGroup);
					}
					modelGroup = new THREE.Group();
					modelGroup.add(model);
					scene.add(modelGroup);

					// Agregar plano de sombra de contacto sutil en la base
					const contactRadius = Math.max(size.x, size.z) * 1.4;
					const contactGeo = new THREE.PlaneGeometry(contactRadius, contactRadius);
					const canvasShadow = document.createElement('canvas');
					canvasShadow.width = 256;
					canvasShadow.height = 256;
					const ctxShadow = canvasShadow.getContext('2d')!;
					const grad = ctxShadow.createRadialGradient(128, 128, 0, 128, 128, 128);
					grad.addColorStop(0, 'rgba(0, 0, 0, 0.7)');
					grad.addColorStop(0.35, 'rgba(0, 0, 0, 0.35)');
					grad.addColorStop(0.7, 'rgba(0, 0, 0, 0.1)');
					grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
					ctxShadow.fillStyle = grad;
					ctxShadow.fillRect(0, 0, 256, 256);

					const shadowTex = new THREE.CanvasTexture(canvasShadow);
					const shadowMat = new THREE.MeshBasicMaterial({
						map: shadowTex,
						transparent: true,
						depthWrite: false,
						opacity: 0.6
					});
					const shadowPlane = new THREE.Mesh(contactGeo, shadowMat);
					shadowPlane.rotation.x = -Math.PI / 2;
					// Situar ligeramente por debajo del punto inferior
					shadowPlane.position.y = -size.y / 2 - 0.04;
					scene.add(shadowPlane);

					// Ajuste de encuadre óptico para que el modelo se aprecie al doble de escala inicial
					const radius = Math.max(sphere.radius, size.length() / 2);
					const fovRad = camera.fov * (Math.PI / 180);
					const aspect = camera.aspect;
					// Adaptar cálculo de FOV si la pantalla es vertical para evitar recortes
					const effectiveFov = aspect < 1 
						? 2 * Math.atan(Math.tan(fovRad / 2) / aspect) 
						: fovRad;
					// Factor reducido de 1.25 a 0.65 para duplicar la presencia y volumen visual del objeto
					const distance = (radius / Math.sin(effectiveFov / 2)) * 0.65;

					initialCameraPos.set(distance * 0.92, distance * 0.48, distance * 0.92);
					camera.position.copy(initialCameraPos);
					camera.lookAt(0, 0, 0);

					// Límites de órbita adaptados a la nueva escala
					controls.target.set(0, 0, 0);
					controls.minDistance = radius * 0.45; // Permite acercarse a ver detalles arquitectónicos
					controls.maxDistance = distance * 3.5;
					// Permitir inclinación desde casi cenital hasta poco debajo del ecuador
					controls.minPolarAngle = Math.PI * 0.08;
					controls.maxPolarAngle = Math.PI / 2 + 0.08;
					controls.update();

					// Completar carga
					if (loadingBar) loadingBar.style.width = '100%';
					if (loadingPercentText) loadingPercentText.textContent = '100%';
					if (loaderStatusText) {
						loaderStatusText.textContent = '¡Modelo listo!';
					}

					setTimeout(() => {
						if (loaderOverlay) {
							loaderOverlay.classList.add('opacity-0', 'pointer-events-none');
							setTimeout(() => {
								loaderOverlay.style.display = 'none';
							}, 500);
						}
					}, 250);
				},
				(progress) => {
					if (progress.lengthComputable && progress.total > 0) {
						const pct = Math.round((progress.loaded / progress.total) * 75) + 15;
						if (loadingBar) loadingBar.style.width = `${pct}%`;
						if (loadingPercentText) loadingPercentText.textContent = `${pct}%`;
					}
				},
				(error) => {
					console.error('Error al cargar casa_flotante.glb:', error);
					showError('No se pudo decodificar el modelo 3D o sus mallas comprimidas.');
				}
			);
		} catch (err: any) {
			console.error('Error durante la inicialización del modelo:', err);
			showError(err?.message || 'Fallo de inicialización WebGL.');
		}
	}

	function showError(msg: string) {
		if (loaderOverlay) {
			loaderOverlay.style.display = 'none';
		}
		if (errorOverlay && errorMessage) {
			errorMessage.textContent = msg;
			errorOverlay.classList.remove('hidden');
			errorOverlay.style.display = 'flex';
		}
	}

	// Interacción con UI de controles
	if (toggleAutoRotateBtn) {
		toggleAutoRotateBtn.addEventListener('click', () => {
			updateAutoRotateUI(!isAutoRotating);
		});
	}

	if (resetCameraBtn) {
		resetCameraBtn.addEventListener('click', () => {
			if (!camera || !controls) return;
			// Transición suave de posición
			const startPos = camera.position.clone();
			const targetPos = initialCameraPos.clone();
			const startTime = performance.now();
			const duration = 800; // ms

			function step(now: number) {
				const elapsed = now - startTime;
				const t = Math.min(1, elapsed / duration);
				// Curva easeOutCubic
				const ease = 1 - Math.pow(1 - t, 3);

				camera.position.lerpVectors(startPos, targetPos, ease);
				controls.target.lerpVectors(controls.target, initialCameraTarget, ease);
				controls.update();

				if (t < 1) {
					requestAnimationFrame(step);
				}
			}
			requestAnimationFrame(step);
		});
	}

	if (retryLoadBtn) {
		retryLoadBtn.addEventListener('click', () => {
			loadModel();
		});
	}

	// Gestión del Modal Ficha Técnica
	function openModal() {
		if (!techModal) return;
		techModal.classList.remove('hidden');
		// Forzar reflow para animación
		void techModal.offsetWidth;
		techModal.classList.remove('opacity-0');
		document.body.style.overflow = 'hidden';
	}

	function closeModal() {
		if (!techModal) return;
		techModal.classList.add('opacity-0');
		setTimeout(() => {
			techModal.classList.add('hidden');
			document.body.style.overflow = '';
		}, 300);
	}

	if (openModalBtn) openModalBtn.addEventListener('click', openModal);
	if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
	if (closeModalFooterBtn) closeModalFooterBtn.addEventListener('click', closeModal);
	if (modalContactBtn) modalContactBtn.addEventListener('click', closeModal);

	// Cerrar al presionar Escape o clic fuera
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && techModal && !techModal.classList.contains('hidden')) {
			closeModal();
		}
	});

	if (techModal) {
		techModal.addEventListener('click', (e) => {
			if (e.target === techModal) {
				closeModal();
			}
		});
	}

	// Inicializar al cargar el DOM
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => {
			initScene();
			loadModel();
		});
	} else {
		initScene();
		loadModel();
	}
</script>
