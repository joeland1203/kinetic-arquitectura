					</div>

					<div class="bg-black/70 px-3 py-1 border border-white/10 ml-auto flex items-center space-x-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-white"></span>
						<span class="text-neutral-300 tracking-wider">ÓRBITA 360°</span>
					</div>
				</div>

				<!-- Pantalla de Carga y Descompresión con Meshoptimizer -->
				<div id="loaderOverlay" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-[#080808]/95 transition-opacity duration-500">
					<div class="relative flex items-center justify-center mb-4">
