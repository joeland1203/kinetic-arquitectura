									<th class="py-2 pr-4 font-normal">COMPONENTE</th>
									<th class="py-2 px-4 font-normal">MATERIAL</th>
									<th class="py-2 px-4 font-normal">RESISTENCIA</th>
									<th class="py-2 pl-4 font-normal text-right">CERTIFICACIÓN</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-white/5 text-neutral-300">
								<tr>
									<td class="py-2 pr-4 text-white font-medium">Cubierta Superior</td>
									<td class="py-2 px-4">Polímero ETFE bicapa autolimpiante</td>
