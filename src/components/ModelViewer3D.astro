				<!-- Tabla de Acabados y Materialidad -->
				<div class="space-y-2 pt-2">
					<div class="font-mono text-[11px] tracking-wider text-neutral-300 uppercase">Matriz de Materialidad y Resistencia</div>
					<div class="overflow-x-auto">
						<table class="w-full text-left font-mono text-[11px] border-collapse">
							<thead>
