---
// src/components/ModelViewer3D.astro
---

<section id="modelo-3d" class="relative w-full min-h-screen bg-[#080808] text-neutral-100 overflow-hidden py-16 md:py-24 px-6 md:px-12 flex flex-col justify-center border-t border-white/[0.06]">
	<!-- Fondo atmosférico con gradiente radial arquitectónico -->
	<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_35%,rgba(28,28,35,0.45)_0%,rgba(8,8,8,0.95)_75%,#080808_100%)]"></div>

	<!-- Rejilla y cruces de alineación isométrica técnica -->
	<div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#ffffff04_1px,transparent_1px),linear-gradient(to_bottom,#ffffff04_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
	<div class="pointer-events-none absolute top-10 left-10 font-mono text-[9px] tracking-[0.3em] text-neutral-600 uppercase select-none">
		KINETIC LAB // VOLUMETRIC VIEWPORT 0.98M VERTS
	</div>
	<div class="pointer-events-none absolute top-10 right-10 font-mono text-[9px] tracking-[0.3em] text-neutral-600 uppercase select-none hidden sm:block">
		MESHOPT // EXT_meshopt_compression READY
	</div>

	<!-- Contenedor Principal en Grid Responsive -->
	<div class="relative z-10 max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
		
		<!-- Columna Izquierda: Tarjeta Editorial Técnica Minimalista "KINETIC" -->
		<div class="lg:col-span-5 flex flex-col justify-center space-y-6">
			
			<!-- Encabezado de Proyecto -->
			<div class="space-y-3">
				<div class="inline-flex items-center space-x-2.5 px-3 py-1 border border-white/10 bg-white/[0.02]">
					<span class="w-1.5 h-1.5 rounded-full bg-white"></span>
					<span class="font-mono text-[10px] tracking-[0.25em] text-neutral-400 uppercase">
						KINETIC LAB // PROYECTO EXPERIMENTAL 04
					</span>
				</div>

				<h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-white leading-[1.1]">
					PROYECTO ISLA<br />
					<span class="text-neutral-500">FLOTANTE</span>
				</h2>

				<p class="text-xs sm:text-sm text-neutral-400 font-light leading-relaxed max-w-md pt-1">
					Exploración volumétrica de una residencia modular sobre espejo de agua, optimizada estructuralmente en voladizo para cimentación no invasiva.
				</p>
			</div>

			<!-- Tags Requeridos -->
			<div class="flex flex-wrap gap-2 pt-1">
				<span class="px-3 py-1 text-[10px] font-mono tracking-wider text-neutral-300 bg-white/[0.03] border border-white/10">
					Residencia Bioclimática
				</span>
				<span class="px-3 py-1 text-[10px] font-mono tracking-wider text-white bg-white/[0.08] border border-white/20">
					Render Volumétrico 3D
				</span>
				<span class="px-3 py-1 text-[10px] font-mono tracking-wider text-neutral-300 bg-white/[0.03] border border-white/10">
					Estructura en Cantilever
				</span>
			</div>

			<!-- Especificaciones Breves (Grid Técnico) -->
			<div class="grid grid-cols-2 gap-4 py-4 border-y border-white/10 font-mono">
				<div class="space-y-1">
					<span class="text-[10px] uppercase tracking-[0.2em] text-neutral-500 block">Área de Desplante</span>
					<span class="text-xs sm:text-sm font-semibold text-white tracking-wide block">420 m² en Voladizo</span>
					<span class="text-[10px] text-neutral-400 font-sans block">Estructura flotante autosoportada</span>
				</div>
				<div class="space-y-1">
					<span class="text-[10px] uppercase tracking-[0.2em] text-neutral-500 block">Paisajismo</span>
					<span class="text-xs sm:text-sm font-semibold text-white tracking-wide block">Bioma Regenerativo</span>
					<span class="text-[10px] text-neutral-400 font-sans block">Simbiosis lacustre y humedal</span>
				</div>
				<div class="space-y-1 col-span-2 pt-2 border-t border-white/[0.05]">
					<span class="text-[10px] uppercase tracking-[0.2em] text-neutral-500 block">Materiales Sustentables</span>
					<span class="text-xs sm:text-sm font-semibold text-neutral-200 tracking-wide block">Polímeros Bioclimáticos & Madera Tectónica Certificada</span>
					<span class="text-[10px] text-neutral-400 font-sans block">Captación pasiva, aislación térmica de baja transmitancia y ciclado 100% de agua</span>
				</div>
			</div>

			<!-- Botones de Acción y Controles Rápidos -->
			<div class="flex flex-col sm:flex-row gap-3 pt-2">
				<button id="openModalBtn" type="button" class="cursor-pointer inline-flex items-center justify-center space-x-2 px-6 py-3.5 text-xs font-semibold tracking-[0.2em] uppercase text-black bg-white hover:bg-neutral-200 transition-all duration-200 rounded-full shadow-lg shadow-white/10 active:scale-98">
					<span>Explorar Modelo / Ficha Técnica</span>
					<span class="text-sm">↗</span>
				</button>
			</div>

			<!-- Ayuda interactiva de navegación 3D -->
			<div class="flex items-center space-x-3 text-[11px] font-mono text-neutral-500">
				<span class="inline-block w-2 h-2 rounded-full bg-emerald-500/80 animate-pulse"></span>
				<span>Arrastra con clic primario para orbitar • Rueda de scroll para zoom</span>
			</div>
		</div>

		<!-- Columna Derecha: Visor 3D Interactivo de Estudio Arquitectónico -->
		<div class="lg:col-span-7 w-full flex flex-col items-center">
			
			<div id="canvasWrapper" class="relative w-full aspect-[4/3] sm:aspect-[16/11] lg:aspect-[16/12] max-h-[680px] overflow-hidden bg-neutral-950 border border-white/10">
				
				<!-- Canvas de Three.js -->
				<canvas id="modelCanvas" class="w-full h-full block cursor-grab active:cursor-grabbing outline-none select-none"></canvas>

				<!-- Gradiente sutil para profundidad de campo -->
