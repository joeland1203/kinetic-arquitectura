						<span class="w-1.5 h-1.5 rounded-full bg-white"></span>
						<span>KINETIC 3D VIEWPORT</span>
					</div>

					<!-- Botones flotantes de control de cámara -->
					<div class="flex items-center space-x-2 pointer-events-auto">
						<button id="toggleAutoRotateBtn" type="button" title="Pausar / Reanudar Auto-rotación" class="cursor-pointer px-3 py-1 bg-black/70 hover:bg-neutral-900 border border-white/10 hover:border-white/20 text-[10px] font-mono text-neutral-300 transition-colors flex items-center space-x-1.5">
							<span id="rotateIcon" class="inline-block transition-transform duration-300">⟳</span>
							<span id="rotateLabel">Auto-rotación ON</span>
						</button>
						<button id="resetCameraBtn" type="button" title="Restablecer Posición de Cámara" class="cursor-pointer px-3 py-1 bg-black/70 hover:bg-neutral-900 border border-white/10 hover:border-white/20 text-[10px] font-mono text-neutral-300 transition-colors flex items-center space-x-1">
							<span>↺</span>
							<span class="hidden sm:inline">Reset</span>
						</button>
					</div>
				</div>

				<!-- Barra Inferior del Visor (Datos y Métricas en Tiempo Real) -->
				<div class="absolute bottom-4 left-4 right-4 flex items-center justify-between pointer-events-none z-10 font-mono text-[10px] text-neutral-400">
					<div class="bg-black/70 px-3 py-1 border border-white/10 hidden sm:flex items-center space-x-2">
						<span class="text-neutral-500">MALLA:</span>
						<span class="text-neutral-200">985K Vértices</span>
						<span class="text-neutral-600">|</span>
						<span class="text-neutral-500">FORMATO:</span>
